# Public Supabase values are safe to expose in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only integrations (leave blank to show an unavailable provider).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure Stripe webhook endpoint: /api/payment-webhooks?provider=stripe
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to the browser.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
MOYASAR_API_KEY=
MOYASAR_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Optional notification webhook called by your deployment after paid orders.
ORDER_NOTIFICATION_WEBHOOK_URL=
# OAuth providers are configured in Supabase Auth (server-side redirect URLs).
SUPABASE_GOOGLE_CLIENT_ID=
SUPABASE_GOOGLE_CLIENT_SECRET=
SUPABASE_APPLE_CLIENT_ID=
SUPABASE_APPLE_CLIENT_SECRET=
# Optional observability and email automation hooks (never called from the browser).
ERROR_MONITORING_DSN=
EMAIL_AUTOMATION_WEBHOOK_URL=
ADMIN_EMAILS=
BACKUP_EXPORT_BUCKET=
PAYOUT_MINIMUM=25
# Server-controlled affiliate conversion rates, for example {"EUR":0.92,"SAR":3.75}.
AFFILIATE_FX_RATES_JSON=
